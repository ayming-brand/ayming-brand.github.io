      "nom": "Couverture",
      "fichier": ".claude/skills/slides/templates/archetypes/archetype-cover.html",
      "represente": "Slide d'ouverture, logo, titre de l'offre, visuel plein cadre.",
      "frequence": {
        "slides": 27,
